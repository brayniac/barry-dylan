# Configuration for `barry-dylan review-rack`.
#
# A rack review is a systemslab experiment: it acquires a GPU host, creates an
# ephemeral VM, pulls the model from slipway, serves it with llama-server, runs
# `barry-dylan review-offline` inside the guest, and returns the review as an
# artifact.
#
#   barry-dylan review-rack \
#     --config rack.toml \
#     --files changed-files.json \
#     --out review.json
#
# Same inputs and same output as `review-offline` -- only where the model runs
# differs. Barry never speaks to the model, so the GPU host needs no GitHub
# credentials and the guest is destroyed the moment the review is done.
#
# The alternative, a resident llama-server, would hold a GPU host out of the
# measurement pool permanently. That is the trade this exists to avoid.

systemslab = "http://systemslab"

# Where the reviewers run.
#
#   sequential  (default) one guest, models served in turn. Uses one GPU host
#               and leaves the other free.
#   concurrent  one guest per reviewer, as separate jobs in the same
#               experiment. systemslab schedules them onto different
#               hypervisors, so each pulls over its own link -- roughly halving
#               wall clock, at the cost of occupying both of the rack's GPUs.
#
# Measured here: create-to-reachable ~20 s, a 9 GB model pull ~79 s, and
# llama-server loads a 14B q4 in ~4 s from a warm page cache. So the model
# RELOAD between two reviewers is nearly free -- the pull is what costs, and on
# one host the two pulls share a single 1 GbE link. Giving guests the X710
# ports is what actually fixes this: at 10 Gb/s the pull is seconds.
#
# NOTE: this must appear BEFORE the [[reviewers]] tables. A top-level key
# written after them belongs to the last table.
# placement = "sequential"

# Which hypervisor the job may land on. These pick the HOST and must agree with
# `shape`: a z2. shape cannot run on a Zen1 host.
#   z2.baremetal -> hv01 (Zen2)      z1.baremetal -> hv02 (Zen1)
host_tags = ["z2.baremetal"]

# anvil instance type, and the default for every reviewer. The `g` class is what
# gets a GPU passed through. Sizes were removed on 2026-09-09, so an instance
# takes its whole host.
shape = "z2.g"

# Guest image. debian-13-gpu carries the NVIDIA driver, CUDA, llama-server and
# slipway. barry-dylan itself is NOT in the image -- the job installs it from
# the rack's internal apt repo at run time, so shipping a new barry does not
# mean rebuilding a 7.5 GB image.
image = "spool/images/debian-13-gpu@golden"

# One block per reviewer. `identity` matches barry's own identity slugs, and the
# review comes back keyed by it. Order is the order they run in when sequential.
#
# `model` is a slipway reference: `slipway ls` on delta lists what exists, and
# most entries are safetensors, which llama.cpp cannot serve, so filter for
# /gguf/. `model_name` is what the model is called over the OpenAI-compatible
# API -- llama-server serves one model and does not route on it, but it is
# echoed back into logs.
#
# Reviewers that share a model share the server: the weights are pulled and
# loaded once, and both reviews run against it. The diversity is then in the
# sampling rather than the model, which is weaker than two genuinely different
# models but costs nothing -- the pull is the expensive part of a rack review.
[[reviewers]]
identity = "barry"
model = "Qwen/Qwen3.5-9B@latest/gguf/q4_k_m@latest"
model_name = "qwen3.5-9b"

[[reviewers]]
identity = "other_barry"
model = "Qwen/Qwen3.5-9B@latest/gguf/q4_k_m@latest"
model_name = "qwen3.5-9b"
# Under `concurrent` this reviewer lands on the other hypervisor, which is a
# different generation, so it needs its own shape and matching tags. Under
# `sequential` both of these are ignored.
# shape = "z1.g"
# host_tags = ["z1.baremetal"]

# llama-server context window. A review sends whole patches, so context is
# usually the scarce resource rather than parameters -- a 9B q4 is 5.4 GiB on a
# 24 GB card, leaving ~18 GB for KV cache, where a 27B q4 is 15.7 GiB and leaves
# ~8 GB. Prefer the smaller model and the bigger window unless the reviews
# themselves are visibly weak.
# context_size = 65536

# Cap on a single completion inside the guest.
# max_tokens = 4096

# How often to ask whether the experiment has finished.
# poll_interval_secs = 10

# Give up on the experiment after this long. Covers scheduling, instance
# creation, a multi-gigabyte model pull, model load and the review itself.
# job_timeout_secs = 3600

# Bound on the payload inside the guest. Deliberately shorter than
# job_timeout_secs, which also covers time spent queued behind another job.
# payload_timeout_secs = 3000
