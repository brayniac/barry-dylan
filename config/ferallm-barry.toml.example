# ferallm config for serving barry's reviewers from a Mac.
#
# ferallm keeps its engine knobs in this file and its serving parameters on
# the command line, so most of what matters is the launch line below. This
# file only pins the process memory ceiling, which on a laptop that is also
# someone's workstation is the setting that matters most.
#
# Sized for Qwen3.5-122B-A10B at q4_k_m (70.6 GiB of weights) on a 128 GB
# M4 Max, serving both barry identities and the judge from one model:
#
#   ferallm serve \
#     --config ~/ferallm-barry.toml \
#     --model ~/models/Qwen3.5-122B-A10B \
#     --served-model-name qwen3.5-122b-a10b \
#     --bind 10.1.0.11:4242 \
#     --workload serving \
#     --max-batch-size 4 \
#     --max-prefill-tokens-per-step 4096 \
#     --max-queue 64 \
#     --num-cache-blocks 32768 \
#     --radix-snapshot-interval 2048 \
#     --radix-budget-gb 8 \
#     --max-tokens-cap 16384
#
# Why each of those, so the numbers can be redone for another model or box:
#
# --workload serving      The profile for concurrent API clients: mixed-step
#                         prefill/decode, 2048-token prefill chunks, layered
#                         prefill, adaptive spec-decode. barry is exactly that
#                         traffic: two identities x four personas in parallel,
#                         then synthesis, then a judge, per pull request.
#
# --max-batch-size 4      Concurrent sequences, and so concurrent PREFILLS. One
#                         review is eight persona requests at once; at batch 8
#                         with a 16 GiB pool, eight 12k-token prefills exceeded
#                         Metal's memory and the server aborted (SIGABRT,
#                         "command buffer execution failed: Insufficient
#                         memory", 2026-09-18 23:47Z). At 4 the eight run in two
#                         waves; a 27-file review took about 25 minutes end to
#                         end instead of crashing. The profile default of 64 is
#                         for many small clients.
#
# --max-prefill-tokens-per-step 4096
#                         Caps prompt tokens ingested per step across all
#                         sequences, which bounds the transient attention
#                         memory of a prefill wave. The serving profile leaves
#                         it unbounded; the interactive profile sets a finite
#                         one for this reason.
#
# --num-cache-blocks 32768
#                         The paged KV pool, in blocks of 64 tokens of ONE
#                         full-attention layer, shared across every layer and
#                         every sequence in flight. Capacity in tokens is
#                         blocks * 64 / full-attention layers: the 27B has 16,
#                         so 32768 blocks is 131k tokens for the whole process.
#                         8192 was 32,768, which three 12k-token persona prompts
#                         overflowed together (infra#22, 2026-09-18: sequences
#                         dropped mid-step as "length" with zero tokens;
#                         ferallm's own 400 spells the formula out when one
#                         request alone cannot fit). Measured at batch 4 on a
#                         27-file review: peak 39,904 of 65,536 K+V blocks, so
#                         a third to spare. Each block is 64 KiB of K and 64 KiB
#                         of V in bf16 here, so the pool is 4 GiB; check
#                         `ferallm_kv_blocks_used` and
#                         `ferallm_cache_exhausted_total` on /metrics.
# --radix-snapshot-interval 2048
#                         Radix prefix reuse is worth keeping: barry sends the
#                         diff as the system prompt, so the four persona
#                         requests of one identity share a long prefix and only
#                         the first pays to prefill it. But on this family every
#                         cut point snapshots the 37 linear-attention layers'
#                         SSM state (about 31 MiB per cut point on the 35B, more
#                         here), and the profile's 256-token interval would put
#                         a 23k sequence at ninety cut points. 2048 is eleven.
#
# --radix-budget-gb 8     Bounds retained-prefix snapshot memory across
#                         requests, LRU-evicted. Reviews of different PRs share
#                         nothing, so retention past the current review is
#                         waste.
#
# --max-tokens-cap 16384  What barry asks for (`[rack] max_tokens` / the
#                         profiles' `max_tokens`). Anything above is a bug on
#                         barry's side and is better rejected than served.
#
# No --api-key            ferallm warns at boot that a non-loopback bind is
#                         unauthenticated and serves anyway. The network is the
#                         rack and two Macs, all one person's, so the warning is
#                         accepted. To add one later: `--api-key <anything>`
#                         here, and the same value in an env var named by
#                         `[llm.*] api_key_env` on delta; barry sends it as a
#                         bearer token.
#
# Budget for the 27B at q4_k_m: 15.7 GiB weights + 4 GiB KV pool + up to 8 GiB
# radix + prefill activations (bounded by the two flags above) is about 30 GiB
# steady; the crash at batch 8 shows the activations are the term to respect. The 122B (70.6 GiB, 12
# full-attention layers, so 131072 blocks is 700k tokens) is about 97 GiB.
#
# The same launch for Qwen3.6-35B-A3B (20.2 GiB, 3B active: several times the
# decode speed, a third of the memory, three months newer). Its blocks are
# shared across only 10 full-attention layers, so 81920 blocks is 524k tokens
# for 10 GiB, and the batch can be wider because each slot is cheap:
#
#   ferallm serve \
#     --config ~/ferallm-barry.toml \
#     --model /Volumes/Models/Qwen/Qwen3.6-35B-A3B/Qwen3.6-35B-A3B-Q4_K_M.gguf \
#     --served-model-name qwen3.6-35b-a3b \
#     --bind 10.1.0.11:4242 \
#     --workload serving \
#     --max-batch-size 24 \
#     --max-queue 64 \
#     --num-cache-blocks 81920 \
#     --radix-snapshot-interval 2048 \
#     --radix-budget-gb 8 \
#     --max-tokens-cap 16384
#
# Budget there: 20.2 + 10 (pool) + 8 + a few GiB is about 42 GiB; `memory_limit_gb
# = 60.0` is a comfortable ceiling.

[memory]
# Process memory ceiling for the MLX allocator, in GiB. Allocations past it
# fail rather than push the rest of the machine into swap. Lower it if the
# laptop needs more for its own work; the server then admits fewer sequences.
memory_limit_gb = 100.0
# The GPU wired limit is left at the system default. On this 128 GB M4 Max
# MLX reports a recommended working set of 107.5 GiB (`iogpu.wired_limit_mb`
# is 0, so the kernel picks it), which already covers the 93 GiB budget above.
# Setting `wired_limit_gb` only makes sense to raise it past that, at the cost
# of everything else on the machine; there is no reason to here.
# wired_limit_gb = 107.5
