# Repositories barry acts on. Absent means every repository the Apps are
# installed on -- which, if they were installed with "All repositories", is
# every repository in the account.
#
# A spend gate, not an authorization boundary: the installation is what bounds
# what the Apps can reach, and this bounds what barry chooses to spend on. A
# review costs real compute, so the two being the same set should be a decision
# rather than a default.
#
# repos = ["you/project", "you/other-project"]

# GitHub logins who may command barry from a pull request comment: any
# `/barry` command, or `@barry-dylan`, which means `/barry review`. Checked
# against the comment's author as GitHub signed it into the delivery, so a
# name typed in the body is not enough.
#
# Absent means NOBODY -- every comment command is dropped, and startup says so.
# The alternative default is "anyone who can comment can spend a GPU host".
#
# A commander's comment also gets through `repos`: one review of the head as
# it stands, in a repository barry does not otherwise act on. The repository
# stays unlisted -- its pushes, closes and everyone else's comments are still
# dropped -- so a second push needs a second ask.
#
commands_from = ["you"]

[server]
listen = "0.0.0.0:8181"
public_url = "https://barry.example.com"

# Where GitHub cannot reach barry directly -- a rack behind a LAN, a laptop --
# barry holds a smee.io channel open from the inside and feeds what arrives to
# its own webhook endpoint. Absent means barry is reachable at `public_url` and
# GitHub posts to it directly.
#
# The channel URL is the App's webhook URL. smee keeps no backlog: anything
# delivered while this is disconnected is lost, and GitHub still records a 200
# from smee itself, so watch `/healthz` rather than the delivery log.
#
# [relay]
# smee_url = "https://smee.io/aBcDeF123456"
# require_signature = true   # default; see the docs before turning it off

# Three GitHub Apps, one per reviewer identity. They appear as distinct
# users in the PR UI (Barry, Other Barry, Other Other Barry). Only Barry
# receives webhooks; OB and OOB are write-only identities that mint
# installation tokens to post reviews and check-runs.
[github.barry]
app_id = 111111
private_key_path = "/etc/barry/barry-app.pem"
webhook_secret_env = "BARRY_WEBHOOK_SECRET"

[github.other_barry]
app_id = 222222
private_key_path = "/etc/barry/other-barry-app.pem"

[github.other_other_barry]
app_id = 333333
private_key_path = "/etc/barry/other-other-barry-app.pem"

[storage]
sqlite_path = "/var/lib/barry/barry.db"

[dispatcher]
debounce_secs = 30
worker_count = 4
job_timeout_secs = 1800
checker_timeout_secs = 600

# Per-identity LLM endpoints. Mix providers freely — Barry can be
# Anthropic, Other Barry a local llama.cpp, Other Other Barry OpenAI,
# and the judge a small fast model.
[llm.barry]
provider = "anthropic"
endpoint = "https://api.anthropic.com"
api_key_env = "ANTHROPIC_API_KEY"
model = "claude-sonnet-4-6"
max_tokens = 8192
# Sampling temperature. Absent leaves it to the endpoint: a hosted API uses its
# default, a local llama-server the model's own recommendation.
# temperature = 0.7
request_timeout_secs = 300

[llm.other_barry]
provider = "openai"
endpoint = "http://localhost:8080/v1"
model = "qwen2.5-coder-32b"
max_tokens = 8192
request_timeout_secs = 300

[llm.other_other_barry]
provider = "openai"
endpoint = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
model = "gpt-4o"
max_tokens = 8192
request_timeout_secs = 300

# Optional: run the reviewer identities on the rack instead of calling their
# endpoints directly. Each review happens in an ephemeral GPU VM that is
# destroyed afterwards, rather than against a resident llama-server holding a
# measurement host out of the pool.
#
# When present, [llm.barry] and [llm.other_barry] above are not used to produce
# reviews -- the rack reviewers replace them. [llm.judge] IS still used:
# reconciling two finished reviews needs no GPU.
#
# See config/rack.toml.example for every key. The same file works with
# `barry-dylan review-rack` for a one-off review outside the webhook path.
#
# [rack]
# systemslab = "http://systemslab"
# host_tags = ["z2.baremetal"]
# shape = "z2.g.medium"
# How long to wait for a host before giving up AND cancelling. Separate from
# job_timeout_secs on purpose: a review is worth a GPU host when someone is
# waiting for it and worth nothing when they are not, so a busy rack gets a
# quick "the rack was busy" rather than a place in the queue.
# queue_timeout_secs = 900
# Queue position when the rack is contended: 300 is "advisory review" in
# infra's priorities guide, below claimed measurements (350) and gating CI (400).
# priority = 300
# The in-guest judge's completion cap. Not 512: a model that reasons before
# answering spends that thinking and returns nothing.
# judge_max_tokens = 4096
# image = "spool/images/debian-13-gpu@golden"

# What the guest installs before reviewing, from the rack's internal apt repo.
# The image carries the platform (driver, CUDA, rezolus) and a job installs the
# workload: debian-13-gpu bakes neither llama-server nor the slipway client.
# Pin them in a real deployment -- unpinned, a review's toolchain changes the
# day either is republished. Default: ["slipway", "llama-server"], unpinned.
# packages = ["slipway=0.2.3-1", "llama-server=10502-1"]
#
# Reconcile the two reviews in the guest that produced them, against the model
# already loaded there. With this on, [llm.judge] is not needed either -- and
# then barry holds no LLM credential at all and no diff leaves the rack.
# Requires the default sequential placement: concurrent reviewers are in
# separate guests and neither can see the other's review.
# judge = true
#
# [[rack.reviewers]]
# identity = "barry"
# model = "Qwen/Qwen2.5-Coder-14B-Instruct@latest/gguf/q4_k_m@latest"
# model_name = "qwen2.5-coder-14b"
#
# [[rack.reviewers]]
# identity = "other_barry"
# model = "meta-llama/Llama-3.1-8B@latest/gguf/q5_k_m@latest"
# model_name = "llama-3.1-8b"

# The judge reconciles Barry and Other Barry. Use a small, fast model.
# Not needed when [rack] judge = true, which does this in the guest instead.
[llm.judge]
provider = "anthropic"
endpoint = "https://api.anthropic.com"
api_key_env = "ANTHROPIC_API_KEY"
model = "claude-haiku-4-5-20251001"
max_tokens = 512
request_timeout_secs = 60

# /barry confer — who may summon another Barry on a PR, and how often.
# Roles match GitHub repo permissions ("read", "write", "maintain", "admin")
# plus the special "author" role (matches the PR author regardless of perms).
[confer]
allowed = ["author", "write", "maintain", "admin"]
max_per_pr = 2

# Persona overrides — custom prompts for each reviewer identity.
# Each persona has a `prompt_path` field to override the default prompt.
# [personas.security]
# prompt_path = "/path/to/custom-security.md"
# [personas.correctness]
# prompt_path = "/path/to/custom-correctness.md"
# [personas.style]
# prompt_path = "/path/to/custom-style.md"
# [personas.rust]
# prompt_path = "/path/to/custom-rust.md"
